# AI
AI_PROVIDER=anthropic              # anthropic | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5   # focus group (Critic)

# Cost vs value (set prices from the provider's CURRENT pricing page)
# Source: https://platform.claude.com/docs/en/about-claude/pricing (checked 2026-11-07), converted at 1 USD = 0.87 EUR.
# Sonnet 5.5: $2 input, $10 output per MTok.
# Haiku 5.5, prompts up to 100,000 tokens: $0.10 input, $0.50 output per MTok ($0.50 / $2.50 above that).
AI_PRICE_INPUT_EUR_PER_MTOK=1.74
AI_PRICE_OUTPUT_EUR_PER_MTOK=8.7
AI_PRICE_FAST_INPUT_EUR_PER_MTOK=0.087
AI_PRICE_FAST_OUTPUT_EUR_PER_MTOK=0.435
AI_BUDGET_EUR=4                    # real calls stop (HTTP 402) once ai_usage reaches this total
VALUE_HOURLY_RATE_EUR=20
VALUE_MINUTES_SAVED_PER_CAMPAIGN=120

# Supabase (server only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram — Instagram API with Instagram Login (graph.instagram.com)
IG_DATA_MODE=live                  # live | mock (mock reads data/ig-snapshot.json or the fixture)
IG_GRAPH_HOST=auto                 # auto | facebook (graph.facebook.com) | instagram (graph.instagram.com)
IG_API_VERSION=v27.0               # latest version in Meta docs on 2026-11-07
IG_MAIN_USER_ID=                   # the 130k account: READ data + reply to comments
IG_MAIN_ACCESS_TOKEN=
IG_PUBLISH_USER_ID=                # test account used for publishing in the demo
IG_PUBLISH_ACCESS_TOKEN=
PUBLISH_MODE=mock                  # live | mock

# Facebook Page (OPTIONAL)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# Notifications
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Adobe Express Embed SDK
NEXT_PUBLIC_ADOBE_CLIENT_ID=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCKS=false
